# NewsFlow Pro - Environment Configuration Template
# Copy this file to .env and fill with your actual values

# Server Configuration
PORT=3333
WS_PORT=3334
TEMPLATE_PORT=8080
HOST=your.server.ip

# Database Configuration (Supabase)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CasparCG Server Configuration
CASPAR_HOST=your_casparcg_server_ip
CASPAR_PORT=5250

# FTP Upload Configuration for CasparCG Media
FTP_ENABLED=true
FTP_HOST=your_ftp_server_ip
FTP_PORT=21
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_SECURE=true
FTP_MEDIA_PATH=/

# Optional: Logging Configuration
LOG_LEVEL=info
LOG_FILE_ENABLED=true

# Optional: Development Mode
NODE_ENV=development