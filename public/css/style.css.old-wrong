/**
 * iNEWS Professional 2025 - Complete GUI Replication
 * Designed to match exact broadcast interface
 */

:root {
    /* Base Colors */
    --bg-primary: #1a1a1a;
    --bg-secondary: #2a2a2a;
    --bg-elevated: #333333;
    --text-primary: #ffffff;
    --text-secondary: #cccccc;
    --text-muted: #999999;
    --border-color: #404040;

    /* Brand Colors */
    --inews-red: #E91E63;
    --inews-pink: #EC407A;

    /* Status Colors */
    --color-success: #4CAF50;
    --color-warning: #FF9800;
    --color-error: #F44336;
    --color-info: #2196F3;

    /* Type Colors (from GUI) */
    --color-gfx: #FF9800;
    --color-live: #F44336;
    --color-vo: #2196F3;
    --color-sot: #4CAF50;
    --color-pkg: #9C27B0;
    --color-rdr: #757575;
    --color-brk: #424242;

    /* ON AIR Status */
    --on-air-bg: #D32F2F;
    --on-air-text: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    height: 100vh;
    overflow: hidden;
    font-size: 13px;
}

#app {
    height: 100vh;
    display: flex;
    flex-direction: column;
}

/* =============================================================================
   HEADER
============================================================================= */
.inews-header {
    height: 48px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    position: relative;
    z-index: 100;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 24px;
}

.inews-logo {
    display: flex;
    align-items: center;
    gap: 8px;
}

.logo-in {
    background: var(--inews-red);
    color: white;
    font-weight: 800;
    font-size: 16px;
    padding: 4px 8px;
    border-radius: 4px;
    line-height: 1;
}

.logo-text {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
}

.tg-selector {
    position: relative;
    display: flex;
    align-items: center;
}

.tg-selector select {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 6px 32px 6px 12px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
    appearance: none;
    cursor: pointer;
}

.tg-selector i {
    position: absolute;
    right: 10px;
    pointer-events: none;
    color: var(--text-muted);
    font-size: 12px;
}

.on-air-status {
    background: var(--on-air-bg);
    color: var(--on-air-text);
    padding: 6px 12px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 12px;
}

.on-air-label {
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.on-air-time {
    font-family: 'Courier New', monospace;
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 6px;
    border-radius: 2px;
}

.header-right {
    display: flex;
    align-items: center;
}

.user-area {
    display: flex;
    align-items: center;
    gap: 12px;
}

.user-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
}

.btn-notification,
.btn-settings {
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
}

.btn-notification:hover,
.btn-settings:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
}

/* =============================================================================
   TOOLBAR
============================================================================= */
.inews-toolbar {
    height: 40px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    padding: 0 16px;
    gap: 2px;
}

.toolbar-btn {
    height: 32px;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0 12px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    transition: all 0.2s;
    min-width: 80px;
    justify-content: center;
}

.toolbar-btn:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
}

.toolbar-btn.active {
    background: var(--color-info);
    color: white;
}

.toolbar-btn i {
    font-size: 12px;
}

/* =============================================================================
   MAIN LAYOUT
============================================================================= */
.inews-layout {
    flex: 1;
    display: flex;
    position: relative;
    height: calc(100vh - 88px - 24px); /* Header + Toolbar + Status Bar */
}

/* =============================================================================
   RUNDOWN PANEL (LEFT)
============================================================================= */
.rundown-panel {
    width: 320px;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
}

.panel-header {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-elevated);
}

.panel-header h2 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
}

.rundown-stats {
    display: flex;
    gap: 16px;
    font-size: 11px;
    color: var(--text-muted);
}

.rundown-stats strong {
    color: var(--text-primary);
}

.rundown-table-container {
    flex: 1;
    overflow-y: auto;
}

.rundown-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
}

.rundown-table th {
    background: var(--bg-elevated);
    padding: 8px 6px;
    text-align: left;
    font-weight: 600;
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
}

.rundown-table td {
    padding: 8px 6px;
    border-bottom: 1px solid var(--border-color);
    vertical-align: middle;
}

.rundown-table tr:hover {
    background: var(--bg-elevated);
    cursor: pointer;
}

.rundown-table tr.selected {
    background: var(--color-info);
    color: white;
}

.rundown-table tr.selected .type-badge {
    background: rgba(255, 255, 255, 0.2);
    color: white;
}

.rundown-table tr.selected .media-icon {
    background: rgba(255, 255, 255, 0.3);
}

/* Type Badge Styling */
.type-badge {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    min-width: 32px;
    text-align: center;
}

.type-badge.gfx { background: var(--color-gfx); color: white; }
.type-badge.live { background: var(--color-live); color: white; }
.type-badge.vo { background: var(--color-vo); color: white; }
.type-badge.sot { background: var(--color-sot); color: white; }
.type-badge.pkg { background: var(--color-pkg); color: white; }
.type-badge.rdr { background: var(--color-rdr); color: white; }
.type-badge.brk { background: var(--color-brk); color: white; }

/* Media Icons */
.media-icons {
    display: flex;
    gap: 2px;
}

.media-icon {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    font-weight: 700;
    color: white;
}

.media-icon.video { background: var(--color-info); }
.media-icon.audio { background: var(--color-success); }
.media-icon.graphic { background: var(--color-warning); }

/* =============================================================================
   STORY PANEL (CENTER)
============================================================================= */
.story-panel {
    flex: 1;
    background: var(--bg-primary);
    display: flex;
    flex-direction: column;
}

.story-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
}

.story-info h2 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text-primary);
}

.story-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

.story-type-badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.story-type-badge.live { background: var(--color-live); color: white; }
.story-type-badge.vo { background: var(--color-vo); color: white; }
.story-type-badge.sot { background: var(--color-sot); color: white; }
.story-type-badge.pkg { background: var(--color-pkg); color: white; }
.story-type-badge.gfx { background: var(--color-gfx); color: white; }

.story-duration {
    font-size: 12px;
    color: var(--text-muted);
}

.story-writer {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-muted);
}

.story-writer .approved {
    color: var(--color-success);
    font-size: 14px;
}

.approve-text {
    color: var(--text-muted);
    font-size: 11px;
}

.story-content {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
}

.script-sections {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.script-section {
    background: var(--bg-secondary);
    border-radius: 6px;
    overflow: hidden;
}

.section-header {
    padding: 8px 12px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-color);
}

.section-tag {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
}

.section-tag.live { color: var(--color-live); }
.section-tag.vo { color: var(--color-vo); }

.section-content {
    padding: 12px;
    line-height: 1.6;
    font-size: 13px;
}

.section-content p {
    margin-bottom: 8px;
}

/* =============================================================================
   MEDIA PANEL (RIGHT)
============================================================================= */
.media-panel {
    width: 280px;
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

.media-section {
    border-bottom: 1px solid var(--border-color);
}

.media-section .section-header {
    padding: 12px 16px;
    background: var(--bg-elevated);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
}

.media-section h3 {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.btn-add {
    background: var(--color-info);
    color: white;
    border: none;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-add:hover {
    background: #1976D2;
}

.media-list {
    padding: 8px;
}

.media-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border-radius: 4px;
    margin-bottom: 4px;
    transition: all 0.2s;
    cursor: pointer;
}

.media-item:hover {
    background: var(--bg-elevated);
}

.media-item .media-icon {
    width: 40px;
    height: 28px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    font-weight: 700;
    color: white;
    text-transform: uppercase;
}

.media-item .media-icon.video { background: var(--color-info); }
.media-item .media-icon.audio { background: var(--color-success); }
.media-item .media-icon.gfx { background: var(--color-warning); }

.media-info {
    flex: 1;
    min-width: 0;
}

.media-name {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.media-specs {
    font-size: 9px;
    color: var(--text-muted);
    margin-bottom: 2px;
}

.media-duration {
    font-size: 10px;
    color: var(--text-secondary);
    font-weight: 600;
}

/* =============================================================================
   BREAKING NEWS OVERLAY
============================================================================= */
.breaking-news-overlay {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 280px;
    background: var(--bg-secondary);
    border: 2px solid var(--color-error);
    border-radius: 6px;
    overflow: hidden;
    z-index: 50;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

.breaking-news-header {
    background: var(--color-error);
    color: white;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: center;
}

.breaking-news-content {
    padding: 12px;
}

.breaking-news-content h3 {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text-primary);
    line-height: 1.3;
}

.breaking-news-content p {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.4;
}

.live-indicator {
    background: var(--color-error);
    color: white;
    padding: 1px 4px;
    border-radius: 2px;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
}

/* =============================================================================
   CONTROL PANEL
============================================================================= */
.control-panel {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 280px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 16px;
    z-index: 50;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

.control-buttons {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.control-btn {
    flex: 1;
    height: 36px;
    border: none;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    transition: all 0.2s;
}

.control-btn.cue {
    background: var(--color-warning);
    color: white;
}

.control-btn.take {
    background: var(--color-success);
    color: white;
}

.control-btn.stop {
    background: var(--color-error);
    color: white;
}

.control-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.control-btn i {
    font-size: 14px;
}

.device-status {
    margin-bottom: 16px;
}

.device-status h4 {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
}

.status-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
}

.status-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    color: var(--text-secondary);
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-error);
}

.status-item.connected .status-dot {
    background: var(--color-success);
}

.status-item.warning .status-dot {
    background: var(--color-warning);
}

.status-item.error .status-dot {
    background: var(--color-error);
}

.program-timeline h4 {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
}

.timeline-bar {
    height: 8px;
    background: var(--bg-elevated);
    border-radius: 4px;
    position: relative;
    margin-bottom: 4px;
}

.timeline-progress {
    height: 100%;
    background: var(--color-info);
    border-radius: 4px;
    position: relative;
}

.timeline-marker {
    position: absolute;
    right: 0;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--color-warning);
    border-radius: 1px;
}

.timeline-times {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--text-muted);
}

/* =============================================================================
   STATUS BAR
============================================================================= */
.status-bar {
    height: 24px;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    font-size: 11px;
}

.status-left {
    display: flex;
    align-items: center;
    gap: 20px;
}

.status-bar .status-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
}

.status-bar .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
}

.status-bar .status-dot.connected {
    background: var(--color-success);
}

.status-right {
    font-family: 'Courier New', monospace;
    color: var(--text-secondary);
}

/* =============================================================================
   NOTIFICATIONS & MODALS
============================================================================= */
#notifications {
    position: fixed;
    top: 100px;
    right: 20px;
    z-index: 1000;
}

.notification {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 12px 16px;
    margin-bottom: 8px;
    min-width: 300px;
    color: var(--text-primary);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    transform: translateX(100%);
    transition: all 0.3s ease;
}

.notification.show {
    transform: translateX(0);
}

.notification.success {
    border-left: 4px solid var(--color-success);
}

.notification.error {
    border-left: 4px solid var(--color-error);
}

#modal-container {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2000;
}

#modal-container.active {
    display: block;
}

.modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
}

.modal {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--bg-elevated);
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    max-width: 90vw;
    max-height: 90vh;
    overflow: hidden;
}

/* =============================================================================
   RESPONSIVE
============================================================================= */
@media (max-width: 1200px) {
    .rundown-panel {
        width: 280px;
    }

    .media-panel {
        width: 240px;
    }

    .breaking-news-overlay,
    .control-panel {
        width: 240px;
    }
}

@media (max-width: 900px) {
    .inews-layout {
        flex-direction: column;
    }

    .rundown-panel,
    .media-panel {
        width: 100%;
        height: 200px;
    }

    .breaking-news-overlay,
    .control-panel {
        position: relative;
        top: auto;
        right: auto;
        bottom: auto;
        width: 100%;
        margin: 8px;
    }
}
/* SOT Interview Section */
.sot-interview {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.sot-info {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
}

.sot-duration {
    background: var(--color-sot);
    color: white;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: 600;
}

.sot-person {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.sot-person strong {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
}

.sot-title {
    font-size: 11px;
    color: var(--text-muted);
}

.section-tag.sot { color: var(--color-sot); }
.section-tag.gfx { color: var(--color-gfx); }
